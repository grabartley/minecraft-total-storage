{
  "schemaVersion": 1,
  "id": "too-many-chests",
  "version": "${version}",
  "name": "Too Many Chests",
  "description": "A better item storage solution for Minecraft.",
  "authors": [
    "Vitória Vedana",
    "Graham Bartley"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/too-many-chests",
    "sources": "https://github.com/grabartley/minecraft-too-many-chests",
    "issues": "https://github.com/grabartley/minecraft-too-many-chests/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.grahambartley.toomanychests.TooManyChests"
    ],
    "client": [
      "com.grahambartley.toomanychests.TooManyChestsClient"
    ],
    "fabric-gametest": [
      "com.grahambartley.toomanychests.gametest.StorageProviderResolverGameTest",
      "com.grahambartley.toomanychests.gametest.ServerConfigServiceGameTest",
      "com.grahambartley.toomanychests.gametest.ConfigSyncGameTest",
      "com.grahambartley.toomanychests.gametest.NetworkEligibilityGameTest",
      "com.grahambartley.toomanychests.gametest.ContainerDiscoveryScanGameTest",
      "com.grahambartley.toomanychests.gametest.PresetTagResolverGameTest",
      "com.grahambartley.toomanychests.gametest.NetworkIndexScanGameTest",
      "com.grahambartley.toomanychests.gametest.SortCandidateFactoryGameTest",
      "com.grahambartley.toomanychests.gametest.DataComponentKeyGameTest",
      "com.grahambartley.toomanychests.gametest.LockedSlotsAttachmentGameTest",
      "com.grahambartley.toomanychests.gametest.LockToggleServiceGameTest",
      "com.grahambartley.toomanychests.gametest.NetworkIndexInvalidationGameTest",
      "com.grahambartley.toomanychests.gametest.NetworkMembershipGameTest",
      "com.grahambartley.toomanychests.gametest.TerminalBlockGameTest"
    ]
  },
  "mixins": [
    "too-many-chests.mixins.json",
    {
      "config": "too-many-chests.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "too-many-chests.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": ">=0.116.12+1.21.1",
    "geckolib": ">=4.7"
  },
  "suggests": {
    "jei": "*",
    "emi": "*"
  }
}
